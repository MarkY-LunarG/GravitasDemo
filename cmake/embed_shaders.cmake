# Put WGSL files into a C++ header, so that the executable needs no shader files at run time.
# Each file becomes a std::string_view in the namespace hackathon::shaders. The name comes from the
# file name: ship_glow.wgsl becomes kShipGlow.
#
# The text is a byte array, not a string literal, because MSVC limits a string literal to 16 KB.
#
# Script mode: cmake -DOUTPUT=<header> -DINPUTS=<file;file;...> -P embed_shaders.cmake

if (NOT CMAKE_SCRIPT_MODE_FILE)
    # Add a header with the shaders to a target. The header is <binary dir>/generated/shaders.h.
    function(hackathon_embed_shaders target)
        set(output "${CMAKE_BINARY_DIR}/generated/shaders.h")
        add_custom_command(
            OUTPUT "${output}"
            COMMAND ${CMAKE_COMMAND} "-DOUTPUT=${output}" "-DINPUTS=${ARGN}"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
            DEPENDS ${ARGN} "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
            COMMENT "Embedding the WGSL shaders"
            VERBATIM)
        target_sources(${target} PRIVATE "${output}")
        target_include_directories(${target} PRIVATE "${CMAKE_BINARY_DIR}/generated")
    endfunction()
    return()
endif()

set(text "// Generated by cmake/embed_shaders.cmake. Do not edit.\n\n#pragma once\n\n")
string(APPEND text "#include <string_view>\n\nnamespace hackathon::shaders {\n")
foreach(input IN LISTS INPUTS)
    get_filename_component(stem "${input}" NAME_WE)
    # snake_case to kCamelCase.
    string(REPLACE "_" ";" words "${stem}")
    set(name "k")
    foreach(word IN LISTS words)
        string(SUBSTRING "${word}" 0 1 first)
        string(SUBSTRING "${word}" 1 -1 rest)
        string(TOUPPER "${first}" first)
        string(APPEND name "${first}${rest}")
    endforeach()

    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    # 24 bytes on each line.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){24})" "\\1\n    " bytes "${bytes}")

    string(APPEND text "\n// ${stem}.wgsl\n")
    string(APPEND text "inline constexpr char ${name}Data[] = {\n    ${bytes}0x00};\n")
    string(APPEND text "inline constexpr std::string_view ${name}(${name}Data, ${size});\n")
endforeach()
string(APPEND text "\n}  // namespace hackathon::shaders\n")

# Write only when the text changes, so that an unchanged header does not cause a rebuild.
set(old "")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
